# Configuración de base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=volbot

# Redis configuration
REDIS_URL=redis://redis:6379

# Configuración de Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_SYMBOL=BTCUSDT
BINANCE_TESTNET=false

# Configuración de Trading
PAPER_TRADING=false

# Configuración de análisis IA (Ollama)
ANALISIS_IA=false
IA_BLOCKS_TRADES=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_MS=20000
IA_MIN_CONFIDENCE=0.72

# Cooldown anti-rachas de stop loss
STOPLOSS_STREAK_THRESHOLD=2
STOPLOSS_COOLDOWN_HOURS=6

# Configuración de logs
LOG_LEVEL=debug

# Configuración de notificaciones
WHATSAPP_ENABLED=false
WHATSAPP_NUMBER=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
