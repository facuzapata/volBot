# Copy to .env.v2, ignored by Git. These are required placeholders, not usable secrets.
TRADING_MODE=PAPER
V2_POSTGRES_PASSWORD=
V2_DATABASE_URL=postgresql://volbot_v2:YOUR_URL_ENCODED_PASSWORD@localhost:15432/volbot_v2
V2_JWT_SECRET=
V2_ADMIN_EMAIL=admin@example.com
V2_ADMIN_PASSWORD=
V2_INITIAL_CAPITAL=500
V2_REDIS_URL=redis://localhost:16379
V2_KAFKA_BROKERS=localhost:19092
V2_API_PORT=3100
V2_WORKER_PORT=3101
V2_POSTGRES_PORT=15432
V2_REDIS_PORT=16379
V2_KAFKA_PORT=19092
V2_STRATEGY=btc-v2
V2_REFRESH_TOKEN_TTL_DAYS=7
# Set false only for local HTTP development; keep true on HTTPS deployments.
V2_COOKIE_SECURE=false
V2_CORS_ORIGIN=http://localhost:5173
# Base64-encoded 32 random bytes. It encrypts each user's Binance credentials at rest.
V2_CREDENTIAL_ENCRYPTION_KEY=
# Keep false until the Testnet order lifecycle has been accepted. Required for Binance production keys.
V2_LIVE_TRADING_ENABLED=false
V2_FEE_RATE=0.001
V2_SPREAD_BPS=2
V2_SLIPPAGE_BPS=3
V2_PARTICIPATION_RATE=0.001
V2_TAKE_PROFIT=0.01
V2_ATR_MULTIPLIER=1.5
V2_MAX_HOLDING_HOURS=24
V2_TRAILING=false
V2_TELEGRAM_ENABLED=false
V2_TELEGRAM_BOT_TOKEN=
# Read-only commands via long polling, worker only. Requires no public webhook.
V2_TELEGRAM_COMMANDS_ENABLED=true

# Opt-in for NEW V6 PAPER positions. Existing positions keep their original exits.
V2_V6_DYNAMIC_TP_ENABLED=false
V2_V6_DYNAMIC_TP_NOISE_HALF_LIFE_MS=30000
V2_V6_DYNAMIC_TP_NOISE_MULTIPLIER=3
# V3 remains unapproved and opt-in. Do not change the operational .env.v2 automatically.
# V2_MAX_RISK_PER_TRADE=0.005
# Optional JSON overrides must match the calibration's complete parameter hash.
V3_PARAMETERS_JSON={}
# A V3 worker abstains without an explicitly configured, hash-verified calibration file.
V3_CALIBRATION_FILE=
V3_CALIBRATION_SHA256=
